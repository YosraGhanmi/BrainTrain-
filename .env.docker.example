# LOCAL TEST VALUES ONLY. Replace passwords/secrets before production.
# Keep POSTGRES_PASSWORD URL-safe (openssl rand -hex 24).
POSTGRES_DB=braintrain
POSTGRES_USER=braintrain
POSTGRES_PASSWORD=localtestpassword123
# Allows Prisma CLI generation on the host; Compose overrides this for the app.
# PostgreSQL is not published to the host by this Compose configuration.
DATABASE_URL=postgresql://braintrain:localtestpassword123@localhost:5432/braintrain?schema=public
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=localtestadmin123
ADMIN_SESSION_SECRET=local-test-only-replace-with-openssl-rand-hex-32
PORTAL_SESSION_SECRET=local-test-only-replace-with-another-random-secret
CRON_SECRET=local-test-only-replace-before-production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRINGTUNE_DEV_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
