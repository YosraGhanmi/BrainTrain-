# Admin dashboard — set all three before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Parent Portal + Child Follow-Up System
# ---------------------------------------------------------------------------

# Firebase client configuration (safe to expose in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=change-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=change-me
NEXT_PUBLIC_FIREBASE_APP_ID=change-me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=change-me

# Firebase Admin SDK (server-only). Keep these out of NEXT_PUBLIC_* variables.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"

# Signs parent/teacher session cookies. Set a long random value before deploying.
PORTAL_SESSION_SECRET=change-me-portal-secret

# OVH SMTP (used for 2FA codes, parent approval emails, etc.)
# ssl0.ovh.net:465 for SSL, ssl0.ovh.net:587 for STARTTLS
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=your@ovh-email.com
SMTP_PASS=change-me
EMAIL_FROM="BrainTrain <your@ovh-email.com>"

# Stripe — test-mode keys are fine for local dev (https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# ⚠️  WARNING: Stripe does NOT support TND (Tunisian Dinar) for most accounts.
# Before going live, swap the Stripe client for a TND-capable local gateway:
# Flouci (flouci.app), Konnect (konnect.network), or Paymee (paymee.tn).
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me

# SMS provider — "twilio" is the only implementation for now.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+15005550006

# Shared secret for the payment-reminders cron endpoint (/api/cron/payment-reminders).
CRON_SECRET=change-me-cron-secret

# Public site URL (used for email links, Stripe redirect URLs).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional live content-editing token.
NEXT_PUBLIC_STRINGTUNE_DEV_TOKEN=
