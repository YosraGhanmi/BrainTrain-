// Parent Portal + Child Follow-Up System — relational data only.
// Public-site content (courses, age groups, ...) stays in data/content.json;
// models here reference it by slug (courseSlug / ageGroupSlug), validated in
// application code via lib/content/lookup.ts, not by a DB foreign key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortalRole {
  PARENT
  TEACHER
  SECRETARY
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum ParentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanType {
  MONTHLY
  QUARTERLY
  YEARLY
}

// How the parent intends to pay — captured at enrollment for record-keeping;
// no real card/cheque processing is wired up yet (see Payment's
// stripeSessionId/stripePaymentIntentId, also still unused placeholders).
enum PaymentMethod {
  CASH
  CARD
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

enum SmsPurpose {
  PAYMENT_REMINDER
  PASSWORD_RESET
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  // Optional secondary phone. The primary `phone` can only be deleted once a
  // secondary is on file — it then gets promoted to primary — since `phone`
  // itself stays required (SMS OTP / uniqueness depend on it existing).
  secondaryPhone String? @unique
  // Backup contact email, separate from the required login `email`.
  backupEmail  String?
  passwordHash String
  fullName     String
  role         PortalRole
  // Frozen accounts are blocked at login and have their active sessions
  // revoked immediately — used by admins to suspend a parent/teacher account
  // without deleting their data.
  isFrozen     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Teacher-only second factor: a 4-digit PIN (hashed) the admin hands out
  // alongside the default password. Entered on a dedicated step after
  // password login, before a teacher portal session is created.
  teacherSecretCodeHash String?

  // Email-OTP based 2FA. twoFactorCodeHash/Expiry hold a pending "enable"
  // verification code until it's confirmed; login-time enforcement is not
  // wired up yet (placeholder pending real email delivery — see lib/email).
  twoFactorEnabled        Boolean   @default(false)
  twoFactorCodeHash       String?
  twoFactorCodeExpiresAt  DateTime?

  parent       Parent?
  teacher      Teacher?
  sessions     Session[]
  resetTokens  PasswordResetToken[]

  @@map("users")
}

// DB-backed session so a session can be revoked (logout, password change) —
// unlike the admin panel's stateless HMAC cookie, which can't be revoked.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Forgot-password flow: a 6-digit code sent by SMS, hashed at rest.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique
  // A new signup starts PENDING and can't log in until an admin reviews it
  // (see loginParent) — APPROVED unlocks login and triggers an email;
  // REJECTED blocks login with a message pointing them back to the admin.
  status ParentApprovalStatus @default(PENDING)

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  children Child[]
  smsNotifications SMSNotification[]

  @@map("parents")
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  // Courses this teacher is assigned to teach (data/content.json
  // CourseEntry.slug values, validated in app code — same convention as
  // Child.ageGroupSlug). Set to one course at creation, admin can add/remove
  // more later; a teacher can still be assigned to any CourseSession
  // regardless of this list.
  courseSlugs String[] @default([])

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions CourseSession[]
  notes    TeacherNote[]
  badges   Badge[]

  @@map("teachers")
}

model Child {
  id            String   @id @default(cuid())
  parentId      String
  fullName      String
  dateOfBirth   DateTime
  ageGroupSlug  String
  specialNeeds  String?
  createdAt     DateTime @default(now())

  parent      Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  notes       TeacherNote[]
  badges      Badge[]

  @@index([parentId])
  @@map("children")
}

// Awarded by a teacher to a student — shows up on that child's parent-portal
// dashboard. Free-form title/note (no admin-managed catalog) since teachers
// award these directly from their own portal, same pattern as TeacherNote.
model Badge {
  id         String   @id @default(cuid())
  childId    String
  teacherId  String
  title      String
  note       String?
  emoji      String   @default("🏅")
  // Sticker artwork (public/stickers/...) shown instead of the emoji when
  // set — the emoji stays as the fallback for badges awarded before stickers
  // existed, or if a teacher picks "emoji" instead of a sticker.
  imageUrl   String?
  awardedAt  DateTime @default(now())

  child   Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([teacherId])
  @@map("badges")
}

// One scheduled, capacity-limited class group for a course (courseSlug refers
// to data/content.json's CourseEntry.slug — validated in app code).
model CourseSession {
  id          String   @id @default(cuid())
  courseSlug  String
  teacherId   String?
  dayOfWeek   Int // 0 (Sunday) - 6 (Saturday)
  startTime   String // "16:00"
  endTime     String // "17:30"
  location    String
  capacity    Int
  term        String // e.g. "2026 Fall"
  createdAt   DateTime @default(now())

  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  notes       TeacherNote[]

  @@index([courseSlug])
  @@index([teacherId])
  @@map("course_sessions")
}

model Enrollment {
  id              String           @id @default(cuid())
  childId         String
  courseSessionId String
  status          EnrollmentStatus @default(PENDING)
  enrolledAt      DateTime         @default(now())

  child         Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  courseSession CourseSession  @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  paymentPlan   PaymentPlan?
  payments      Payment[]
  notes         TeacherNote[]

  // Prevents enrolling the same child in the same session twice.
  @@unique([childId, courseSessionId])
  @@index([childId])
  @@index([courseSessionId])
  @@map("enrollments")
}

model PaymentPlan {
  id           String        @id @default(cuid())
  enrollmentId String        @unique
  type         PlanType
  // How the parent said they'll pay, chosen once at enrollment.
  method       PaymentMethod @default(CASH)
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("TND")
  startDate    DateTime      @default(now())
  createdAt    DateTime      @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@map("payment_plans")
}

model Payment {
  id                     String        @id @default(cuid())
  paymentPlanId          String
  enrollmentId           String
  amount                 Decimal       @db.Decimal(10, 2)
  currency               String        @default("TND")
  dueDate                DateTime
  status                 PaymentStatus @default(PENDING)
  paidAt                 DateTime?
  stripeSessionId        String?       @unique
  stripePaymentIntentId  String?
  createdAt              DateTime      @default(now())

  paymentPlan      PaymentPlan       @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  // Denormalized alongside paymentPlan (which also reaches the enrollment via
  // paymentPlan.enrollment) purely so callers like the Stripe webhook and the
  // reminders cron can query/join on Payment without an extra hop — kept as a
  // real FK (not a bare string) so it can never drift out of sync.
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  smsNotifications SMSNotification[]

  @@index([paymentPlanId])
  @@index([enrollmentId])
  @@index([status])
  @@map("payments")
}

// Admin-editable pricing. Exactly one of ageGroupSlug / courseSlug is set on
// each row: ageGroupSlug marks an age group's default rate for that plan
// type (data/content.json AgeGroupEntry.slug); courseSlug marks a
// course-specific override (data/content.json CourseEntry.slug) that a
// course opts into instead of its age group's default — see resolvePrice().
// Postgres treats every NULL as distinct in a unique index, so both
// constraints below coexist without the "" sentinel the single-dimension
// version of this model used to need. Not JSON per the project's
// data-storage rules for payment-adjacent data.
model PricingRule {
  id           String   @id @default(cuid())
  planType     PlanType
  ageGroupSlug String?
  courseSlug   String?
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("TND")
  updatedAt    DateTime @updatedAt

  @@unique([planType, ageGroupSlug])
  @@unique([planType, courseSlug])
  @@map("pricing_rules")
}

model TeacherNote {
  id              String   @id @default(cuid())
  teacherId       String
  childId         String
  courseSessionId String
  enrollmentId    String?
  content         String
  createdAt       DateTime @default(now())

  teacher       Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  child         Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  courseSession CourseSession  @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  enrollment    Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([childId])
  @@index([teacherId])
  @@map("teacher_notes")
}

model SMSNotification {
  id                String     @id @default(cuid())
  parentId          String
  phone             String
  message           String
  purpose           SmsPurpose
  status             SmsStatus  @default(QUEUED)
  provider          String
  providerMessageId String?
  relatedPaymentId  String?
  createdAt         DateTime   @default(now())

  parent         Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relatedPayment Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@map("sms_notifications")
}
