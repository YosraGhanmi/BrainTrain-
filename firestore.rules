rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isParentOfChild(childId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/children/$(childId))
        && get(/databases/$(database)/documents/children/$(childId)).data.parentId == request.auth.uid;
    }

    function isParentOfEnrollment(enrollmentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
        && isParentOfChild(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.childId);
    }

    // ---------------------------------------------------------------------------
    // Users (parents, teachers, secretaries)
    // ---------------------------------------------------------------------------

    // Browser clients may read their own profile, but profile writes are
    // server-only. Role, approval, ownership, frozen-state, 2FA, and reset
    // fields are security-sensitive and are trusted by Server Actions.
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Children
    // ---------------------------------------------------------------------------

    // Parents may read only their own children from the browser. Child writes
    // are server-only to prevent ownership transfer/corruption.
    match /children/{childId} {
      allow read: if isSignedIn()
        && resource != null
        && resource.data.parentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Preinscriptions
    // ---------------------------------------------------------------------------

    // Public preinscription form: anyone can create, only Admin SDK can read/delete.
    match /preinscriptions/{id} {
      allow create: if true;
      allow read, write: if false; // Admin SDK only
    }

    // ---------------------------------------------------------------------------
    // Course sessions, time slots, pricing rules — read by authenticated users
    // ---------------------------------------------------------------------------

    match /course_sessions/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    match /time_slots/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    match /pricing_rules/{id} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    // ---------------------------------------------------------------------------
    // Enrollments, payment plans, payments — parent read only
    // ---------------------------------------------------------------------------

    match /enrollments/{id} {
      allow read: if isSignedIn()
        && resource != null
        && isParentOfChild(resource.data.childId);
      allow write: if false; // Admin SDK only
    }

    match /payment_plans/{id} {
      allow read: if isSignedIn()
        && resource != null
        && isParentOfEnrollment(resource.data.enrollmentId);
      allow write: if false; // Admin SDK only
    }

    match /payments/{id} {
      allow read: if isSignedIn()
        && resource != null
        && isParentOfEnrollment(resource.data.enrollmentId);
      allow write: if false; // Admin SDK only
    }

    // ---------------------------------------------------------------------------
    // Teacher notes and badges — teacher/parent can read their own
    // ---------------------------------------------------------------------------

    match /teacher_notes/{id} {
      allow read: if isSignedIn()
        && (resource.data.teacherId == request.auth.uid
            || isParentOfChild(resource.data.childId));
      allow write: if false; // Admin SDK only (server actions)
    }

    match /badges/{id} {
      allow read: if isSignedIn()
        && (resource.data.teacherId == request.auth.uid
            || isParentOfChild(resource.data.childId));
      allow write: if false; // Admin SDK only
    }

    // ---------------------------------------------------------------------------
    // Admin-only collections (Admin SDK access only from server)
    // ---------------------------------------------------------------------------

    match /notifications/{id} {
      allow read, write: if false;
    }

    match /expenses/{id} {
      allow read, write: if false;
    }

    match /sms_notifications/{id} {
      allow read, write: if false;
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

  }
}
